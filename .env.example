DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
# Opcional. Lista JSON de servidores adicionales con sus propios canales y roles.
# DISCORD_ADDITIONAL_GUILDS='[{"guildId":"ID_SERVIDOR","channels":["ID_CANAL"],"roomCategory":"ID_CATEGORIA","hosterRole":"Hoster"}]'
# Opcionales. STAFF_ROLE_ID complementa el permiso Gestionar servidor.
STAFF_ROLE_ID=
# Para crear pickups, exige este rol o uno superior. Acepta nombre o ID.
PICKUP_HOSTER_ROLE=Hoster
# Roles de dirección que pueden cancelar pickups de otra persona, separados por coma.
PICKUP_CANCEL_ROLE_IDS=
PLAYER_ROLE_ID=
PICKUP_CHANNEL_IDS=
# Para responder a pings de Discord solo en el canal indicado.
PICKUP_NOTICE_CHANNEL_ID=
PICKUP_NOTICE_ROLE_ID=
# Categoría de Discord para abrir una sala privada al iniciar una 5v5.
PICKUP_ROOM_CATEGORY_ID=
# Para registrar comandos, enviar invitaciones por DM y actualizar las fichas caducadas. Mantén el token fuera del repositorio.
DISCORD_BOT_TOKEN=
# URL HTTPS del servicio para los GIFs de los embeds.
PUBLIC_BASE_URL=
DB_PATH=./data/pickups.sqlite
# Opcional. Clave hexadecimal de 64 caracteres para una base ya cifrada.
DB_ENCRYPTION_KEY=
PORT=3000
